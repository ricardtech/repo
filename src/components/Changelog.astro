---
// Changelog.astro
const changelogItems = [
  "Nova Interface Desktop Moderna em React 19 + Tailwind CSS + Shadcn UI com Glassmorphism e Cards 3D",
  "Integração oficial com a API de produção https://playmax.rictv.top e autenticação rápida por 6 dígitos com QR Code",
  "Telemetria em tempo real com detecção nativa de Distribuição Linux (/etc/os-release), hardware e versão",
  "Controle de EPG com botão de Forçar Atualização imediata e limpeza de cache",
  "Seção 'Continuar Assistindo' com retomada de reprodução e barra de progresso percentual",
  "Filtros de Catálogo: Mais Recentes, Melhores Avaliados (IMDb) e Ordem Alfabética (A-Z)",
  "Jogos de Futebol do Dia com placares e canais de transmissão ao vivo",
  "Player otimizado com aceleração de hardware (VA-API), suporte a streams HLS/TS e failover de DNS",
];
---

<section class="changelog-section">
  <div class="changelog-card">
    <div class="changelog-header">
      <div class="changelog-title-box">
        <svg class="changelog-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <h3 class="changelog-title">Notas da Versão v2.2.4</h3>
      </div>
      <span class="changelog-date">Setembro de 2026</span>
    </div>

    <ul class="changelog-list">
      {changelogItems.map((item) => (
        <li class="changelog-item">
          <span class="check-bullet">✓</span>
          <span class="item-text">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .changelog-section {
    width: 100%;
  }

  .changelog-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 18px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .changelog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .changelog-title-box {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .changelog-icon {
    width: 20px;
    height: 20px;
    color: #a855f7;
  }

  .changelog-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
  }

  .changelog-date {
    font-size: 0.8rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 8px;
    border-radius: 6px;
  }

  .changelog-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .changelog-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.87rem;
    color: #cbd5e1;
    line-height: 1.45;
  }

  .check-bullet {
    color: #34d399;
    font-weight: 800;
    font-size: 0.9rem;
    flex-shrink: 0;
  }
</style>
