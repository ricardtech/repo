---
// Changelog.astro
const changelogItems = [
  "Correção de Reprodução M3U8 e TS: Ajuste na engine do HLS.js garantindo carregamento fluido e eliminando tela escura",
  "Controles Sempre Visíveis: Barra superior, botão de voltar e atalho ESC sempre operacionais mesmo durante sincronização ou falha de sinal",
  "Switch Toggle GPU Moderno: Substituição do checkbox quadrado branco por chave deslizante iluminada nas configurações",
  "Deduplicação de Perfis: Agrupamento automático de contas no modal de seleção evitando linhas duplicadas",
  "Auto-Alternância Inteligente de Canais: Troca automática e transparente entre qualidades (FHD -> HD -> SD) caso o sinal fique instável",
  "Nova Central 'Minha Lista' dedicada: Favoritos unificados e Continuar Assistindo com barra de progresso em tempo real",
  "Séries no Histórico: Retomada direta instantânea do episódio e minuto onde parou sem abrir modal intermediário",
  "Segurança & Failover Automático: Criptografia DoT e comutação instantânea para o DNS de contingência",
  "Suporte WhatsApp Dinâmico: Sincronização em tempo real do contato oficial cadastrado no painel administrativo",
];
---

<section class="changelog-section">
  <div class="changelog-card">
    <div class="changelog-header">
      <div class="changelog-title-box">
        <svg class="changelog-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <h3 class="changelog-title">Notas da Versão v2.4.3</h3>
      </div>
      <span class="changelog-date">Outubro de 2026</span>
    </div>

    <ul class="changelog-list">
      {changelogItems.map((item) => (
        <li class="changelog-item">
          <span class="check-bullet">✓</span>
          <span class="item-text">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .changelog-section {
    width: 100%;
  }

  .changelog-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 18px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .changelog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .changelog-title-box {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .changelog-icon {
    width: 20px;
    height: 20px;
    color: #a855f7;
  }

  .changelog-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
  }

  .changelog-date {
    font-size: 0.8rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 8px;
    border-radius: 6px;
  }

  .changelog-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .changelog-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.87rem;
    color: #cbd5e1;
    line-height: 1.45;
  }

  .check-bullet {
    color: #34d399;
    font-weight: 800;
    font-size: 0.9rem;
    flex-shrink: 0;
  }
</style>
